#!/usr/bin/env bash

set -euo pipefail

ARG_INSTALL_GEMINI_CLI='${ARG_INSTALL_GEMINI_CLI}'
ARG_INSTALL_OH_MY_CLAUDE_SISYPHUS='${ARG_INSTALL_OH_MY_CLAUDE_SISYPHUS}'
ARG_INSTALL_OH_MY_CODEX='${ARG_INSTALL_OH_MY_CODEX}'
ARG_INSTALL_OH_MY_OPENAGENT='${ARG_INSTALL_OH_MY_OPENAGENT}'
ARG_INSTALL_OPENCODE_CLI='${ARG_INSTALL_OPENCODE_CLI}'

MODULE_DIRECTORY="$${HOME}/.coder-modules/coder/gcp-loaded"
mkdir -p "$${MODULE_DIRECTORY}/logs"
exec > >(tee -a "$${MODULE_DIRECTORY}/logs/install-optional-tools.log") 2>&1

export PATH="$${HOME}/.local/bin:$${HOME}/.bun/bin:$${PATH}"

persist_user_path() {
  local export_line='export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"'
  local profile

  for profile in "$${HOME}/.profile" "$${HOME}/.bashrc"; do
    touch "$${profile}"
    if ! grep -Fqx "$${export_line}" "$${profile}"; then
      printf '\n%s\n' "$${export_line}" >> "$${profile}"
    fi
  done
}

ensure_node() {
  local node_major=0

  if command -v node > /dev/null 2>&1; then
    node_major="$$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
  fi

  if command -v npm > /dev/null 2>&1 && [ "$${node_major}" -ge 20 ]; then
    return
  fi

  if ! command -v apt-get > /dev/null 2>&1; then
    echo "Node.js 20+ is required, and automatic installation currently supports Debian/Ubuntu images only." >&2
    exit 1
  fi

  curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
  sudo apt-get install -y nodejs
}

install_npm_package() {
  local command_name="$1"
  local package_name="$2"

  if command -v "$${command_name}" > /dev/null 2>&1; then
    echo "$${command_name} is already installed; skipping $${package_name}."
    return
  fi

  npm install --global --prefix "$${HOME}/.local" "$${package_name}"
}

ensure_bun() {
  if command -v bunx > /dev/null 2>&1; then
    return
  fi

  curl -fsSL https://bun.sh/install | bash
  export PATH="$${HOME}/.bun/bin:$${PATH}"
}

if [ "$${ARG_INSTALL_OH_MY_CODEX}" = "true" ] \
  || [ "$${ARG_INSTALL_OH_MY_CLAUDE_SISYPHUS}" = "true" ] \
  || [ "$${ARG_INSTALL_GEMINI_CLI}" = "true" ] \
  || [ "$${ARG_INSTALL_OPENCODE_CLI}" = "true" ] \
  || [ "$${ARG_INSTALL_OH_MY_OPENAGENT}" = "true" ]; then
  persist_user_path
  ensure_node
fi

if [ "$${ARG_INSTALL_OH_MY_CODEX}" = "true" ]; then
  install_npm_package omx oh-my-codex@latest
fi

if [ "$${ARG_INSTALL_OH_MY_CLAUDE_SISYPHUS}" = "true" ]; then
  install_npm_package omc oh-my-claude-sisyphus@latest
fi

if [ "$${ARG_INSTALL_GEMINI_CLI}" = "true" ]; then
  install_npm_package gemini @google/gemini-cli@latest
fi

if [ "$${ARG_INSTALL_OPENCODE_CLI}" = "true" ] || [ "$${ARG_INSTALL_OH_MY_OPENAGENT}" = "true" ]; then
  install_npm_package opencode opencode-ai@latest
fi

if [ "$${ARG_INSTALL_OH_MY_OPENAGENT}" = "true" ]; then
  ensure_bun
  bunx oh-my-openagent install \
    --no-tui \
    --claude=no \
    --openai=no \
    --gemini=no \
    --copilot=no \
    --opencode-go=no \
    --opencode-zen=no \
    --zai-coding-plan=no \
    --kimi-for-coding=no \
    --vercel-ai-gateway=no \
    --skip-auth
fi
