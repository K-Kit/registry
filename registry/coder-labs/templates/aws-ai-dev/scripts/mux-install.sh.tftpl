#!/usr/bin/env bash

if [ -f "$HOME/.bashrc" ]; then
  # shellcheck disable=SC1090
  source "$HOME/.bashrc"
fi

set -euo pipefail

ARG_MUX_VERSION='${ARG_MUX_VERSION}'
ARG_NODE_VERSION='${ARG_NODE_VERSION}'
MODULE_ROOT="$HOME/.coder-modules/coder/mux"
NODE_HOME="$MODULE_ROOT/node"
RUNTIME_DIR="$MODULE_ROOT/runtime"
NPM_DIR="$RUNTIME_DIR/npm"
MUX_BIN="$RUNTIME_DIR/mux"

require_command() {
  if ! command -v "$1" > /dev/null 2>&1; then
    printf 'Error: %s is required to install Mux.\n' "$1" >&2
    exit 1
  fi
}

install_node() {
  local node_arch
  local archive
  local download_url

  if [ -x "$NODE_HOME/bin/node" ] && [ "$("$NODE_HOME/bin/node" --version)" = "v$ARG_NODE_VERSION" ]; then
    return
  fi

  if [ "$(uname -s)" != "Linux" ]; then
    printf 'Error: Mux supports Linux workspaces only.\n' >&2
    exit 1
  fi

  case "$(uname -m)" in
    x86_64 | amd64)
      node_arch="x64"
      ;;
    aarch64 | arm64)
      node_arch="arm64"
      ;;
    *)
      printf 'Error: unsupported CPU architecture: %s.\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac

  archive="$MODULE_ROOT/node-v$ARG_NODE_VERSION-linux-$node_arch.tar.gz"
  download_url="https://nodejs.org/dist/v$ARG_NODE_VERSION/node-v$ARG_NODE_VERSION-linux-$node_arch.tar.gz"

  mkdir -p "$MODULE_ROOT" "$RUNTIME_DIR"
  printf 'Downloading Node.js %s for linux-%s.\n' "$ARG_NODE_VERSION" "$node_arch"
  curl --fail --location --silent --show-error "$download_url" --output "$archive"

  rm -rf "$NODE_HOME"
  mkdir -p "$NODE_HOME"
  tar -xzf "$archive" --strip-components=1 -C "$NODE_HOME"
}

require_command curl
require_command tar
install_node

export PATH="$NODE_HOME/bin:$PATH"

if [ -x "$MUX_BIN" ]; then
  printf 'Mux is already installed at %s.\n' "$MUX_BIN"
  exit 0
fi

mkdir -p "$NPM_DIR"
cd "$NPM_DIR"
[ -f package.json ] || printf '{}\n' > package.json

printf 'Installing Mux %s into %s.\n' "$ARG_MUX_VERSION" "$RUNTIME_DIR"
npm install \
  --no-audit \
  --no-fund \
  --omit=dev \
  --ignore-scripts \
  "mux@$ARG_MUX_VERSION"

if [ ! -f "$NPM_DIR/node_modules/.bin/mux" ]; then
  printf 'Error: Mux installation completed without producing its CLI binary.\n' >&2
  exit 1
fi

ln -sf "$NPM_DIR/node_modules/.bin/mux" "$MUX_BIN"
printf 'Mux installation completed at %s.\n' "$MUX_BIN"
