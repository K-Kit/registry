#!/usr/bin/env bash

if [ -f "$HOME/.bashrc" ]; then
  # shellcheck disable=SC1090
  source "$HOME/.bashrc"
fi

set -euo pipefail

ARG_AUTO_BOOTSTRAP_PROJECT='${ARG_AUTO_BOOTSTRAP_PROJECT}'
ARG_PAIRING_SECRET_B64='${ARG_PAIRING_SECRET_B64}'
ARG_PORT='${ARG_PORT}'
ARG_WORKDIR_B64='${ARG_WORKDIR_B64}'
MODULE_ROOT="$HOME/.coder-modules/coder/t3code"
NODE_HOME="$MODULE_ROOT/node"
RUNTIME_DIR="$MODULE_ROOT/runtime"
T3CODE_BIN="$RUNTIME_DIR/node_modules/.bin/t3"
DATA_DIR="$MODULE_ROOT/data"
RUN_DIR="$${XDG_RUNTIME_DIR:-/tmp}/coder-t3code-$${UID}"
PID_FILE="$RUN_DIR/t3code.pid"
SERVICE_LOG="$MODULE_ROOT/logs/t3code.log"
INSTALL_LOG="$MODULE_ROOT/logs/install.log"
HEALTH_URL="http://127.0.0.1:$ARG_PORT/"

export PATH="$NODE_HOME/bin:$PATH"

http_ready() {
  if command -v curl > /dev/null 2>&1; then
    curl --fail --silent --max-time 2 "$HEALTH_URL" > /dev/null
    return
  fi

  node -e '
    const http = require("node:http");
    const request = http.get(process.argv[1], { timeout: 2000 }, (response) => {
      response.resume();
      process.exit(response.statusCode >= 200 && response.statusCode < 400 ? 0 : 1);
    });
    request.on("timeout", () => request.destroy());
    request.on("error", () => process.exit(1));
  ' "$HEALTH_URL"
}

port_in_use() {
  node -e '
    const net = require("node:net");
    const socket = net.createConnection({
      host: "127.0.0.1",
      port: Number(process.argv[1]),
      timeout: 500,
    });
    socket.on("connect", () => {
      socket.destroy();
      process.exit(0);
    });
    socket.on("timeout", () => {
      socket.destroy();
      process.exit(1);
    });
    socket.on("error", () => process.exit(1));
  ' "$ARG_PORT"
}

process_matches() {
  local pid="$1"
  local command_line=""

  if [[ "$pid" =~ ^[0-9]+$ ]] && [ -r "/proc/$pid/cmdline" ]; then
    command_line="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
  fi

  kill -0 "$pid" 2> /dev/null && [[ "$command_line" == *"$T3CODE_BIN"* ]]
}

mkdir -p "$DATA_DIR" "$RUN_DIR" "$(dirname "$SERVICE_LOG")"

install_deadline=$((SECONDS + 120))
until [ -x "$T3CODE_BIN" ]; do
  if [ "$SECONDS" -ge "$install_deadline" ]; then
    printf 'Error: T3 Code was not installed within 120 seconds. Installation log: %s\n' "$INSTALL_LOG" >&2
    exit 1
  fi
  sleep 2
done

WORKDIR="$(printf '%s' "$ARG_WORKDIR_B64" | base64 --decode)"
WORKDIR="$${WORKDIR/#\~/$HOME}"
WORKDIR="$${WORKDIR//\$HOME/$HOME}"

if [ ! -d "$WORKDIR" ]; then
  printf 'Error: configured T3 Code working directory does not exist: %s.\n' "$WORKDIR" >&2
  exit 1
fi

if http_ready; then
  printf 'T3 Code is already healthy at %s.\n' "$HEALTH_URL"
  exit 0
fi

if [ -f "$PID_FILE" ]; then
  existing_pid="$(cat "$PID_FILE")"
  if process_matches "$existing_pid"; then
    printf 'Error: T3 Code process %s is running but its health check is failing.\n' "$existing_pid" >&2
    exit 1
  fi
  rm -f "$PID_FILE"
fi

if port_in_use; then
  printf 'Error: port %s is already used by another process.\n' "$ARG_PORT" >&2
  exit 1
fi

start_args=(
  start
  --mode web
  --host 127.0.0.1
  --port "$ARG_PORT"
  --base-dir "$DATA_DIR"
  --no-browser
)

if [ "$ARG_AUTO_BOOTSTRAP_PROJECT" = "true" ]; then
  start_args+=(--auto-bootstrap-project-from-cwd)
fi

pairing_secret="$(printf '%s' "$ARG_PAIRING_SECRET_B64" | base64 --decode)"
export T3CODE_PAIRING_SECRET="$pairing_secret"
bootstrap_json="$(
  printf '%s' "$pairing_secret" | "$NODE_HOME/bin/node" -e '
    const fs = require("node:fs");
    const desktopBootstrapToken = fs.readFileSync(0, "utf8");
    process.stdout.write(JSON.stringify({
      mode: "desktop",
      noBrowser: true,
      port: Number(process.argv[1]),
      t3Home: process.argv[2],
      host: "127.0.0.1",
      desktopBootstrapToken,
      tailscaleServeEnabled: false,
      tailscaleServePort: 443,
    }));
  ' "$ARG_PORT" "$DATA_DIR"
)"
unset pairing_secret

printf 'Starting T3 Code at %s with state stored under %s.\n' "$HEALTH_URL" "$DATA_DIR"
nohup "$T3CODE_BIN" "$${start_args[@]}" --bootstrap-fd 3 "$WORKDIR" \
  3<<<"$bootstrap_json" >> "$SERVICE_LOG" 2>&1 &
t3code_pid=$!
unset bootstrap_json T3CODE_PAIRING_SECRET
printf '%s\n' "$t3code_pid" > "$PID_FILE"

for _ in $(seq 1 60); do
  if http_ready; then
    printf 'T3 Code is ready at %s.\n' "$HEALTH_URL"
    exit 0
  fi

  if ! kill -0 "$t3code_pid" 2> /dev/null; then
    wait "$t3code_pid" || exit_code=$?
    rm -f "$PID_FILE"
    printf 'Error: T3 Code exited before becoming healthy (exit code %s). See %s.\n' \
      "$${exit_code:-unknown}" "$SERVICE_LOG" >&2
    exit 1
  fi

  sleep 1
done

kill "$t3code_pid" 2> /dev/null || true
rm -f "$PID_FILE"
printf 'Error: T3 Code did not become healthy within 60 seconds. See %s.\n' "$SERVICE_LOG" >&2
exit 1
