#!/usr/bin/env bash

set -euo pipefail

ARG_NODE_VERSION='${ARG_NODE_VERSION}'
ARG_T3CODE_VERSION='${ARG_T3CODE_VERSION}'
MODULE_ROOT="$HOME/.coder-modules/k-kit/t3code"
NODE_HOME="$MODULE_ROOT/node"
RUNTIME_DIR="$MODULE_ROOT/runtime"
T3CODE_BIN="$RUNTIME_DIR/node_modules/.bin/t3"
K_KIT_RELEASES_URL="https://github.com/K-Kit/t3code/releases"
DESIRED_VERSION=""
PACKAGE_DIR=""
PACKAGE_SPEC=""

require_command() {
  if ! command -v "$1" > /dev/null 2>&1; then
    printf 'Error: %s is required to install T3 Code.\n' "$1" >&2
    exit 1
  fi
}

install_node() {
  local node_arch
  local archive
  local download_url

  if [ -x "$NODE_HOME/bin/node" ] && [ "$("$NODE_HOME/bin/node" --version)" = "v$ARG_NODE_VERSION" ]; then
    return
  fi

  if [ "$(uname -s)" != "Linux" ]; then
    printf 'Error: the T3 Code module currently supports Linux workspaces only.\n' >&2
    exit 1
  fi

  case "$(uname -m)" in
    x86_64 | amd64)
      node_arch="x64"
      ;;
    aarch64 | arm64)
      node_arch="arm64"
      ;;
    *)
      printf 'Error: unsupported CPU architecture: %s.\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac

  archive="$MODULE_ROOT/node-v$ARG_NODE_VERSION-linux-$node_arch.tar.gz"
  download_url="https://nodejs.org/dist/v$ARG_NODE_VERSION/node-v$ARG_NODE_VERSION-linux-$node_arch.tar.gz"

  mkdir -p "$MODULE_ROOT" "$RUNTIME_DIR"
  printf 'Downloading Node.js %s for linux-%s.\n' "$ARG_NODE_VERSION" "$node_arch"
  curl --fail --location --silent --show-error "$download_url" --output "$archive"

  rm -rf "$NODE_HOME"
  mkdir -p "$NODE_HOME"
  tar -xzf "$archive" --strip-components=1 -C "$NODE_HOME"
}

resolve_package() {
  local latest_release_url
  local latest_tag

  case "$ARG_T3CODE_VERSION" in
    latest)
      if ! latest_release_url="$(curl --fail --location --head --silent --show-error --output /dev/null --write-out '%%{url_effective}' "$K_KIT_RELEASES_URL/latest")"; then
        printf 'Error: unable to resolve the latest K-Kit T3 Code release. Check network access or set t3code_version explicitly.\n' >&2
        exit 1
      fi

      latest_tag="$${latest_release_url##*/}"
      if [[ ! "$latest_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-k-kit\.[0-9]+$ ]]; then
        printf 'Error: the latest K-Kit T3 Code release URL returned an invalid tag: %s.\n' "$latest_release_url" >&2
        exit 1
      fi

      DESIRED_VERSION="$${latest_tag#v}"
      ;;
    *-k-kit.*)
      DESIRED_VERSION="$ARG_T3CODE_VERSION"
      ;;
    *)
      DESIRED_VERSION="$ARG_T3CODE_VERSION"
      PACKAGE_DIR="$RUNTIME_DIR/node_modules/t3"
      PACKAGE_SPEC="t3@$DESIRED_VERSION"
      return
      ;;
  esac

  PACKAGE_DIR="$RUNTIME_DIR/node_modules/@k-kit/t3code"
  PACKAGE_SPEC="$K_KIT_RELEASES_URL/download/v$DESIRED_VERSION/k-kit-t3code-$DESIRED_VERSION.tgz"
}


installed_version() {
  if [ ! -f "$PACKAGE_DIR/package.json" ]; then
    return 1
  fi

  PACKAGE_JSON="$PACKAGE_DIR/package.json" "$NODE_HOME/bin/node" -p "require(process.env.PACKAGE_JSON).version"
}

require_command curl
require_command tar
require_command python3
require_command make
require_command c++
install_node

export PATH="$NODE_HOME/bin:$PATH"
resolve_package

# npm 12 blocks dependency install scripts unless the project explicitly approves them.
printf '%s\n' '{"name":"coder-t3code-runtime","private":true,"allowScripts":{"node-pty":true,"msgpackr-extract":true}}' > "$RUNTIME_DIR/package.json"

current_version="$(installed_version || true)"
if [ -x "$T3CODE_BIN" ] && [ "$current_version" = "$DESIRED_VERSION" ]; then
  printf 'T3 Code %s is already installed in %s.\n' "$current_version" "$RUNTIME_DIR"
  exit 0
fi

printf 'Installing %s in %s.\n' "$PACKAGE_SPEC" "$RUNTIME_DIR"
npm install \
  --prefix "$RUNTIME_DIR" \
  --no-save \
  --package-lock=false \
  --omit=dev \
  --no-audit \
  --no-fund \
  --allow-remote=root \
  "$PACKAGE_SPEC"

if [ ! -x "$T3CODE_BIN" ]; then
  printf 'Error: T3 Code installation completed without creating %s.\n' "$T3CODE_BIN" >&2
  exit 1
fi

NODE_PATH="$RUNTIME_DIR/node_modules" "$NODE_HOME/bin/node" -e 'require("node-pty")'
current_version="$(installed_version || true)"
if [ "$current_version" != "$DESIRED_VERSION" ]; then
  printf 'Error: expected T3 Code %s after installation, found %s.\n' "$DESIRED_VERSION" "$${current_version:-unknown}" >&2
  exit 1
fi

printf 'Installed T3 Code %s successfully.\n' "$current_version"
